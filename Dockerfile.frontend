FROM node:22-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build

FROM node:22-alpine
WORKDIR /app
COPY package*.json ./
RUN npm install --omit=dev
COPY --from=builder /app/dist ./dist
COPY server.ts .
COPY src ./src
COPY uploads ./uploads
COPY eng.traineddata ./
EXPOSE 3000
CMD ["npm", "run", "start"]
